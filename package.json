{
  "name": "teacherdesk",
  "version": "2.0.9-alpha",
  "private": true,
  "type": "module",
  "description": "TeacherDesk —— 面向高中班主任的综合工作台",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "deploy": "tcb deploy",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.9.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.2",
    "pinyin-pro": "^3.29.4",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.2.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "unocss": "^66.3.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.0"
  }
}
